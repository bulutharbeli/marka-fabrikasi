{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p dist && cp index.html dist/",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/proxy/image",
      "destination": "/api/proxy"
    },
    {
      "source": "/api/proxy/text",
      "destination": "/api/proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}